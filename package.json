{
  "name": "vetkit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint --type-aware . && sh scripts/ban-raw-json-parse.sh",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt .",
    "test": "vitest run",
    "build": "bun run --filter './packages/*' build",
    "pack": "bun scripts/pack.ts",
    "version": "changeset version && bun install --no-frozen-lockfile",
    "check": "bun run typecheck && bun run lint && bun run fmt && bun run test",
    "codegen": "bun packages/spec/scripts/codegen.ts",
    "hooks:install": "lefthook install"
  },
  "catalog": {
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "tsdown": "0.23.0",
    "oxlint": "1.85.0",
    "oxfmt": "0.70.0",
    "@types/node": "22.20.4",
    "@standard-schema/spec": "1.1.0",
    "zod": "4.6.5",
    "yaml": "2.9.1",
    "@clack/prompts": "1.8.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "oxlint": "1.85.0",
    "oxfmt": "0.70.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "vitest": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "@changesets/cli": "3.0.3",
    "publint": "0.3.24",
    "@arethetypeswrong/cli": "0.18.5",
    "knip": "6.38.0",
    "validate-package-exports": "1.4.5",
    "lefthook": "2.1.14",
    "json-schema-to-typescript": "16.0.0",
    "@types/node": "22.20.4",
    "@standard-schema/spec": "1.1.0",
    "zod": "4.6.5",
    "yaml": "2.9.1",
    "@clack/prompts": "1.8.1",
    "picocolors": "1.1.1"
  }
}
