{
  "name": "@vetkit/source-otlp",
  "version": "0.1.0",
  "description": "Trace source that reads OTLP files or receives OTLP/HTTP spans. Part of vetkit; install vetkit",
  "keywords": [
    "llm",
    "evals",
    "evaluation",
    "typescript",
    "ci",
    "otel",
    "opentelemetry",
    "otlp"
  ],
  "license": "Apache-2.0",
  "homepage": "https://melsovcozy.github.io/vetkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MelsovCOZY/vetkit.git",
    "directory": "packages/source-otlp"
  },
  "bugs": {
    "url": "https://github.com/MelsovCOZY/vetkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
