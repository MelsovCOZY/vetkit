{
  "name": "vetkit",
  "version": "0.0.0",
  "description": "LLM evals as a CI gate: LLM-as-a-judge with typed decisions, vitest export, TypeScript, no API key to try",
  "keywords": [
    "llm",
    "evals",
    "evaluation",
    "jev",
    "typescript",
    "ci",
    "llm-evals",
    "llm-evaluation",
    "llm-as-a-judge",
    "llm-judge",
    "eval",
    "prompt-testing",
    "ai-testing",
    "github-action",
    "vitest",
    "cli"
  ],
  "license": "Apache-2.0",
  "homepage": "https://melsovcozy.github.io/vetkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MelsovCOZY/vetkit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/MelsovCOZY/vetkit/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "vet": "./dist/bin.js",
    "vetkit": "./dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "15.0.0",
    "@clack/prompts": "1.8.1",
    "picocolors": "1.1.1",
    "@vetkit/core": "workspace:^",
    "@vetkit/export-vitest": "workspace:^",
    "@vetkit/generator-openai-compatible": "workspace:^",
    "@vetkit/judge-jev": "workspace:^",
    "@vetkit/sink-langfuse": "workspace:^",
    "@vetkit/sink-otel": "workspace:^",
    "@vetkit/source-jsonl": "workspace:^",
    "@vetkit/source-otlp": "workspace:^",
    "@vetkit/spec": "workspace:^"
  },
  "scripts": {
    "build": "tsdown"
  }
}
