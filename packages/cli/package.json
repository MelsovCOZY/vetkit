{
  "name": "vetkit",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "vet": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "15.0.0",
    "@clack/prompts": "1.8.1",
    "picocolors": "1.1.1",
    "c12": "^3.3.4",
    "@vetkit/core": "workspace:^",
    "@vetkit/export-vitest": "workspace:^",
    "@vetkit/generator-openai-compatible": "workspace:^",
    "@vetkit/judge-jev": "workspace:^",
    "@vetkit/sink-langfuse": "workspace:^",
    "@vetkit/sink-otel": "workspace:^",
    "@vetkit/source-jsonl": "workspace:^",
    "@vetkit/source-otlp": "workspace:^",
    "@vetkit/spec": "workspace:^"
  },
  "scripts": {
    "build": "tsdown"
  }
}
