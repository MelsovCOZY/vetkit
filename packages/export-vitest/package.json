{
  "name": "@vetkit/export-vitest",
  "version": "0.0.0",
  "description": "Exporter that emits a vitest scorer and test file from vetkit criteria",
  "keywords": [
    "llm",
    "evals",
    "evaluation",
    "jev",
    "typescript",
    "ci",
    "vitest"
  ],
  "license": "Apache-2.0",
  "homepage": "https://melsovcozy.github.io/vetkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MelsovCOZY/vetkit.git",
    "directory": "packages/export-vitest"
  },
  "bugs": {
    "url": "https://github.com/MelsovCOZY/vetkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vetkit/spec": "workspace:^"
  },
  "peerDependencies": {
    "vitest": "^5.0.2"
  },
  "devDependencies": {
    "evalite": "1.0.0-beta.16"
  },
  "scripts": {
    "build": "tsdown"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
